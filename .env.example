# ---------------------------------------------------------------------------
# ZamBus API — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=ZamBus API
# Comma-separated list of allowed browser origins for the frontend apps.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:8081

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zambus?schema=public

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_TTL_DAYS=7

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# Public URL of the frontend used in reset links
FRONTEND_URL=http://localhost:5173

# QR ticket signing (separate from JWT secrets)
# HMAC-SHA256 key used to sign the opaque QR payload.
TICKET_QR_SECRET=replace-with-a-third-long-random-value

# Booking rules
SEAT_HOLD_TTL_MINUTES=5
MAX_SEATS_PER_BOOKING=6
BOOKING_REFERENCE_PREFIX=ZB

# GreenTrack
# Version string stamped on every stored calculation so historical reports
# remain explainable even after factors change.
GREENTRACK_METHODOLOGY_VERSION=1.0.0

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Logging
LOG_LEVEL=info
